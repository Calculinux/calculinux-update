[Unit]
Description=Calculinux post-reboot package reconciliation
# Runs without waiting for the network: duplicate removal and conffiles are
# local, reinstalls come from the prefetch cache, and anything that needs the
# feed stays queued. Users are told at login to run 'cup reconcile'.
# Hook always writes updated-slot; pending-* only exist when packages need work.
# OR across these ConditionPathExists so a no-package update still post-processes.
ConditionPathExists=|/var/lib/calculinux-update/update-state.updated-slot
ConditionPathExists=|/var/lib/calculinux-update/update-state.pending-duplicates
ConditionPathExists=|/var/lib/calculinux-update/update-state.pending-reinstalls
# Queue from calculinux-update < 0.8; cup-postreboot drops it
ConditionPathExists=|/var/lib/calculinux-update/update-state.pending-upgrades

[Service]
Type=oneshot
ExecStart=/usr/lib/calculinux-update/cup-postreboot

[Install]
WantedBy=multi-user.target
